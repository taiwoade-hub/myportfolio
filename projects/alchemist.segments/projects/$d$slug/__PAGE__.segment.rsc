65:["$","$L3",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"05"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Implementation"]}],["$","div",null,{"className":"mt-5","children":[["$","div",null,{"className":"space-y-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":"The pipeline separates three concerns rigidly: data ingestion (market data in), structure analysis (a pure engine turning price series into labelled events), and delivery (Telegram formatting and dispatch). The analysis engine is deliberately stateless-per-scan — every observation derives from data it can re-derive — which makes reports reproducible and bugs localisable."}],["$","p","1",{"children":"Terminology discipline is enforced in the delivery layer: the bot reports what happened ('BOS confirmed at level X') and never what to do. That boundary lives in code, not just documentation — advisory phrasing has no template to be rendered from."}]]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-1.5","children":[["$","span","Python",{"className":"inline-flex items-center rounded-md border border-border px-2 py-0.5 font-mono text-[11px] leading-5 text-muted-foreground","children":"Python"}],["$","span","Telegram Bot API",{"className":"inline-flex items-center rounded-md border border-border px-2 py-0.5 font-mono text-[11px] leading-5 text-muted-foreground","children":"Telegram Bot API"}],["$","span","Market Data APIs",{"className":"inline-flex items-center rounded-md border border-border px-2 py-0.5 font-mono text-[11px] leading-5 text-muted-foreground","children":"Market Data APIs"}]]}]]}]]}]}]
66:["$","$L3",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"06"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Engineering challenges"]}],["$","div",null,{"className":"mt-5","children":["$","ul",null,{"className":"space-y-4","children":[["$","li","0",{"className":"grid grid-cols-1 gap-4 rounded-lg border border-border bg-card p-5 sm:grid-cols-[110px_minmax(0,1fr)]","children":[["$","div",null,{"children":[["$","p",null,{"className":"label-mono text-muted-foreground","children":"Challenge"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-foreground/80","children":"Structure detection is noisy: every smoothing choice moves a BOS by candles, and a bot that cries structure constantly trains its user to ignore it."}]]}],["$","div",null,{"className":"sm:border-l sm:border-border sm:pl-4","children":[["$","p",null,{"className":"label-mono text-accent-blue","children":"Approach"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-muted-foreground","children":"Explicit, tunable definitions for every event — the bot reports structure with its parameters visible, so disagreements with the output are resolved by adjusting the definition rather than distrusting the bot."}]]}]]}],["$","li","1",{"className":"grid grid-cols-1 gap-4 rounded-lg border border-border bg-card p-5 sm:grid-cols-[110px_minmax(0,1fr)]","children":[["$","div",null,{"children":[["$","p",null,{"className":"label-mono text-muted-foreground","children":"Challenge"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-foreground/80","children":"Anything adjacent to markets attracts profit-shaped expectations, and tools drift toward feeding them."}]]}],["$","div",null,{"className":"sm:border-l sm:border-border sm:pl-4","children":[["$","p",null,{"className":"label-mono text-accent-blue","children":"Approach"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-muted-foreground","children":"Non-advisory language as a design constraint, no performance claims anywhere in the product, and the project framed everywhere — including here — as analysis software, not a trading system."}]]}]]}]]}]}]]}]}]
