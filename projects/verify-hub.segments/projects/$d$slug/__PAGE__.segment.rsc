68:["$","$L3",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"06"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Engineering challenges"]}],["$","div",null,{"className":"mt-5","children":["$","ul",null,{"className":"space-y-4","children":[["$","li","0",{"className":"grid grid-cols-1 gap-4 rounded-lg border border-border bg-card p-5 sm:grid-cols-[110px_minmax(0,1fr)]","children":[["$","div",null,{"children":[["$","p",null,{"className":"label-mono text-muted-foreground","children":"Challenge"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-foreground/80","children":"Browser automation is inherently flaky — slow pages, transient DNS, headless environment quirks. A verification tool that fails randomly is worse than no tool."}]]}],["$","div",null,{"className":"sm:border-l sm:border-border sm:pl-4","children":[["$","p",null,{"className":"label-mono text-accent-blue","children":"Approach"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-muted-foreground","children":"Explicit timeout budgets per stage, retries with backoff for transient failures, and distinguishing 'the site is broken' from 'the check could not complete' in every report."}]]}]]}],["$","li","1",{"className":"grid grid-cols-1 gap-4 rounded-lg border border-border bg-card p-5 sm:grid-cols-[110px_minmax(0,1fr)]","children":[["$","div",null,{"children":[["$","p",null,{"className":"label-mono text-muted-foreground","children":"Challenge"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-foreground/80","children":"The temptation to over-claim: availability checks drifting into implying security assurance."}]]}],["$","div",null,{"className":"sm:border-l sm:border-border sm:pl-4","children":[["$","p",null,{"className":"label-mono text-accent-blue","children":"Approach"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-muted-foreground","children":"Scoping the language. Reports describe what was checked, and the documentation is explicit that this is availability and rendering verification — not a security audit."}]]}]]}]]}]}]]}]}]
