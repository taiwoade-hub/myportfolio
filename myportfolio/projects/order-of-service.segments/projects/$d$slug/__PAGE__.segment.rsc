",null,{"className":"sm:border-l sm:border-border sm:pl-4","children":[["$","p",null,{"className":"label-mono text-accent-blue","children":"Approach"}],["$","p",null,{"className":"mt-2 text-[13px] leading-relaxed text-muted-foreground","children":"Starting from a small, opinionated set of section types and keeping the block schema open, so new section kinds can be added without reworking the document model."}]]}]]}]]}]}]]}]}]
