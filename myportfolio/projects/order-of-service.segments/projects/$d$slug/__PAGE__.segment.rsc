5e:["$","div",null,{"className":"mt-16 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16","children":[["$","div",null,{"className":"min-w-0 space-y-12","children":[["$","$L3",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"01"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Overview"]}],["$","div",null,{"className":"mt-5","children":["$","div",null,{"className":"space-y-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":"Order of Service is a planning application for drafting, refining and sharing the running order of church services. Instead of a Word document attached to a group chat, the service programme lives in a structured, editable document that updates its preview as you type."}],["$","p","1",{"children":"The project began as a fix for a workflow I saw first-hand: service outlines passed around as files, revised out-of-order, and handed to the media team too late to be useful. It has grown into a broader exploration of document-style applications — how structure, templates and live previews change the way teams plan a recurring event."}]]}]}]]}]}],["$","$L3",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"02"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"The problem"]}],["$","div",null,{"className":"mt-5","children":["$","p",null,{"className":"text-[15px] leading-relaxed text-muted-foreground","children":"Service programmes are recurring, structural documents that are treated like one-off files. Every week the same sections are re-typed, changes arrive via chat messages, and the people who present the service — media, musicians, coordinators — each see a different version of the truth. The problem is not document editing; it is keeping a structured document alive across a team without a specialised tool."}]}]]}]}],["$","$L3",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"03"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Intended users"]}],["$","div",null,{"className":"mt-5","children":["$","p",null,{"className":"text-[15px] leading-relaxed text-muted-foreground","children":"Church service coordinators who draft the programme, administrators who maintain liturgy content, and media/production teams who need the final running order accurately and early enough to rehearse."}]}]]}]}],["$","$L3",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"04"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Key features"]}],["$","div",null,{"className":"mt-5","children":["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex gap-4 text-[15px] leading-relaxed","children":[["$","span",null,{"className":"mt-1.5 font-mono text-[11px] tracking-wider text-accent-blue","children":"01"}],["$","span",null,{"className":"text-muted-foreground","children":"Real-time preview of the running order as it is edited"}]]}],["$","li","1",{"className":"flex gap-4 text-[15px] leading-relaxed","children":["$L62","$L63"]}],"$L64","$L65","$L66"]}]}]]}]}],"$L67","$L68","$L69","$L6a"]}],"$L6b"]}]
