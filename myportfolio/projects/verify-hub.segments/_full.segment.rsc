6f:["$","div",null,{"className":"mt-16 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16","children":[["$","div",null,{"className":"min-w-0 space-y-12","children":[["$","$L14",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"01"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Overview"]}],["$","div",null,{"className":"mt-5","children":["$","div",null,{"className":"space-y-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":"Verify Hub is a verification pipeline for websites: give it a URL and it checks availability, drives a real browser to capture what the page actually rendered, collects errors, and reports the result through Telegram and GitHub — the channels a small team already watches."}],["$","p","1",{"children":"It sits at the intersection of my interests in browser automation and web reliability, and it is scoped deliberately: it verifies availability, rendering and configuration. It does not claim to be a comprehensive security scanner, and its reports are careful to say so."}]]}]}]]}]}],["$","$L14",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"02"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"The problem"]}],["$","div",null,{"className":"mt-5","children":["$","p",null,{"className":"text-[15px] leading-relaxed text-muted-foreground","children":"Knowing whether a deployment actually works is scattered across curl, DevTools, uptime dashboards and memory. For a small team — or one developer wearing every hat — the checks exist but the reporting never arrives where decisions happen. The problem is delivery as much as detection."}]}]]}]}],["$","$L14",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"03"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Intended users"]}],["$","div",null,{"className":"mt-5","children":["$","p",null,{"className":"text-[15px] leading-relaxed text-muted-foreground","children":"Developers and webmasters who want scheduled or on-demand verification of their deployments, reported into chat and issue trackers rather than another dashboard."}]}]]}]}],["$","$L14",null,{"children":["$","section",null,{"className":"border-t border-border pt-8 first:border-t-0 first:pt-0","children":[["$","h2",null,{"className":"label-mono flex items-center gap-3 text-muted-foreground","children":[["$","span",null,{"className":"text-accent-blue","children":"04"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-6 bg-border"}],"Key features"]}],["$","div",null,{"className":"mt-5","children":["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex gap-4 text-[15px] leading-relaxed","children":[["$","span",null,{"className":"mt-1.5 font-mono text-[11px] tracking-wider text-accent-blue","children":"01"}],["$","span",null,{"className":"text-muted-foreground","children":"URL availability and response checks"}]]}],["$","li","1",{"className":"flex gap-4 text-[15px] leading-relaxed","children":[["$","span",null,{"className":"mt-1.5 font-mono text-[11px] tracking-wider text-accent-blue","children":"02"}],["$","span",null,{"className":"text-muted-foreground","children":"Browser-automated page rendering with screenshot capture"}]]}],["$","li","2",{"className":"flex gap-