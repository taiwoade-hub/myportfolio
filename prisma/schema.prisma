generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Messages submitted through the contact form. IPs are stored as
/// salted hashes — rate limiting works, raw addresses don't persist.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ipHash    String?
  userAgent String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
